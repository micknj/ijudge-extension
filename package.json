{
  "name": "tools-ijudge",
  "displayName": "iJudge Extension",
  "description": "An unofficial KMITL iJudge assignment submission extension for VS Code and VSCodium. Part of Mick's Tools.",
  "version": "0.6.0",
  "publisher": "micknj",
  "author": "micknj",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ijudge",
    "kmitl",
    "programming",
    "submission",
    "python",
    "micks-tools"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "micknj.tools.ijudge.submit",
        "title": "Submit to iJudge",
        "icon": "$(arrow-up)"
      },
      {
        "command": "micknj.tools.ijudge.login",
        "title": "iJudge: Login"
      },
      {
        "command": "micknj.tools.ijudge.logout",
        "title": "iJudge: Logout"
      },
      {
        "command": "micknj.tools.ijudge.loginStatus",
        "title": "iJudge: Show Login Status"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "micknj.tools.ijudge.submit",
          "when": "editorLangId == python && resourceScheme == file",
          "group": "navigation@10"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --allow-missing-repository",
    "package:list": "vsce ls --tree"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.0.0"
  }
}